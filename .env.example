# ==============================================================================
# VIT Lost & Found - Environment Variables Reference
# Copy this file to .env.local in apps/web and configure for production/local.
# ==============================================================================

# --- Supabase Public Credentials (Client-Safe) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Supabase Private Credentials (Server-Only, NEVER leak to browser) ---
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# --- AI Embedding Microservice ---
# Public or internal URL of the deployed FastAPI container
EMBEDDING_SERVICE_URL="https://vit-lost-found-embeddings.onrender.com"
# Shared secret key passed in header X-Embedding-Service-Key to authenticate requests
EMBEDDING_SERVICE_SECRET_KEY="vit_sec_embed_live_948fbc2a10e7b4382c7"

# --- Firebase Cloud Messaging (Edge Functions & Push Notifications) ---
# JSON stringified Firebase Service Account Key or individual fields
FIREBASE_PROJECT_ID="vit-lost-and-found"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@vit-lost-and-found.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- Admin Bootstrap Setup Key (One-Time Use) ---
# Used to seed or claim the very first approved staff admin. Rotated or cleared after bootstrap.
ADMIN_BOOTSTRAP_SETUP_KEY="vit_bootstrap_admin_init_83b519ca4e72"

# --- Custom SMTP Provider (Resend / SendGrid / Amazon SES) ---
# Recommended for production student OTP delivery to avoid Supabase default rate-limits
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS="re_123456789"
SMTP_SENDER_NAME="VIT Pune Lost & Found"
SMTP_ADMIN_EMAIL="noreply@vit.edu"
