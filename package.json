{
  "name": "vit-lost-and-found-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted lost and found platform for Vishwakarma Institute of Technology, Pune",
  "scripts": {
    "build": "pnpm --filter ./packages/* --filter ./apps/web build",
    "dev": "pnpm --filter ./apps/web dev",
    "lint": "pnpm --filter ./apps/web lint",
    "typecheck": "pnpm --filter ./packages/* --filter ./apps/web typecheck",
    "test": "pnpm --filter ./apps/web test"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
